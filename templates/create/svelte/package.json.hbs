{
	"name": "{{projectName}}",
	"private": true,
	"version": "0.0.1",
	{{#if (packageManagerManifestValue packageManager)}}
	"packageManager": "{{packageManagerManifestValue packageManager}}",
	{{/if}}
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build{{#if composer}} && esbuild build/index.js --bundle --platform=node --format=esm --banner:js=\"import { createRequire as __composerCreateRequire } from 'node:module'; const require = __composerCreateRequire(import.meta.url);\" --outfile=build/composer.mjs{{/if}}",
		{{#if composer}}
		"start": "node build/composer.mjs",
		{{/if}}
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "svelte-kit sync && {{prismaCommand packageManager "generate"}}"
	},
	"devDependencies": {
		{{#if composer}}
		"@sveltejs/adapter-node": "^5.5.7",
		{{else}}
		"@sveltejs/adapter-auto": "^7.0.1",
		{{/if}}
		"@sveltejs/kit": "^2.67.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.0.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
