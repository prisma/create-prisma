{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "contract:emit": {
      "cache": false
    },
    "db:init": {
      "cache": false
    },
    "db:update": {
      "cache": false
    },
    "db:verify": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "migration:plan": {
      "cache": false
    },
    "migration:apply": {
      "cache": false
    },
    "migration:status": {
      "cache": false
    },
    "migration:show": {
      "cache": false
    }
  }
}
