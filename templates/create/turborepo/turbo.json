{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["service.ts", "packages/database/src/**"],
  "globalPassThroughEnv": ["PORT", "DATABASE_URL", "MONGODB_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
