{{#if (requiresDotenvConfigImport packageManager)}}
import "dotenv/config";
{{/if}}
import { serve } from "@hono/node-server";
import { Hono } from "hono";

import service from "./service";

let composerDatabaseUrl: string | undefined;
try {
  composerDatabaseUrl = {{#if composerPostgres}}service.load().database.url{{else}}service.input().databaseUrl.expose(){{/if}};
} catch {
  composerDatabaseUrl = undefined;
}
if (composerDatabaseUrl) {
  process.env.DATABASE_URL = composerDatabaseUrl;
}
const { prisma } = await import("@repo/db");

const app = new Hono();

app.get("/", (c) => {
  return c.json({
    ok: true,
    message: "Turborepo API is running.",
  });
});

app.get("/users", async (c) => {
  const users = await prisma.user
    .findMany({
      take: 10,
      orderBy: {
        createdAt: "desc",
      },
    })
    .catch((error) => {
      console.error("Failed to query users:", error);
      return undefined;
    });

  if (!users) {
    return c.json(
      {
        error: "Could not query users yet. Run db:migrate and db:seed first.",
      },
      500
    );
  }

  return c.json(users);
});

const rawPort = (process.env.PORT ?? "").trim();
const parsedPort = rawPort.length > 0 ? Number(rawPort) : Number.NaN;

let composerPort: number | undefined;
try {
  composerPort = service.port();
} catch {
  composerPort = undefined;
}

const port =
  (Number.isFinite(parsedPort) && parsedPort >= 0 && parsedPort <= 65535 ? parsedPort : undefined) ?? composerPort ?? 3000;
console.log(`API listening at http://localhost:${port}`);
serve({ fetch: app.fetch, port });
