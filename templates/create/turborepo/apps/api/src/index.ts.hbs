{{#if (requiresDotenvConfigImport packageManager)}}
import "dotenv/config";
{{/if}}
import { serve } from "@hono/node-server";
import { Hono } from "hono";
{{#if (eq schemaPreset "basic")}}
import { listUsers } from "@repo/db";
{{/if}}

const app = new Hono();

app.get("/", (c) => {
  return c.json({
    ok: true,
    message: "Turborepo API is running.",
  });
});
{{#if (eq schemaPreset "basic")}}

app.get("/users", async (c) => {
  const users = await listUsers(10).catch((error) => {
    console.error("Failed to query users:", error);
    return undefined;
  });

  if (!users) {
    return c.json(
      {
        error: "Could not query users yet. Run contract:emit and apply your schema first.",
      },
      500
    );
  }

  return c.json(users);
});
{{/if}}

const rawPort = (process.env.PORT ?? "").trim();
const parsedPort = rawPort.length > 0 ? Number(rawPort) : Number.NaN;
const port =
  Number.isFinite(parsedPort) && parsedPort >= 0 && parsedPort <= 65535 ? parsedPort : 3000;
console.log(`API listening at http://localhost:${port}`);
serve({ fetch: app.fetch, port });
