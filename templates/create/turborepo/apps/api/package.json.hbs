{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "scripts": {
    {{#if (eq packageManager "deno")}}
    "dev": "deno run -A --env-file=../../packages/db/.env --watch src/index.ts",
    "build": "deno check src/index.ts",
    "start": "deno run -A --env-file=../../packages/db/.env src/index.ts",
    "typecheck": "deno check src/index.ts"
    {{else}}
    "dev": "tsx watch src/index.ts",
    "build": "{{#if composer}}esbuild src/index.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire as __composerCreateRequire } from 'node:module'; const require = __composerCreateRequire(import.meta.url);\" --outfile=dist/server.mjs{{else}}tsc{{/if}}",
    "start": "{{#if composer}}node dist/server.mjs{{else}}node dist/src/index.js{{/if}}",
    "typecheck": "tsc --noEmit"
    {{/if}}
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
