import { createFileRoute } from "@tanstack/react-router";

import { createServerFn } from "@tanstack/react-start";
import { prisma } from "../lib/prisma.server";

function isBootstrapQueryError(error: unknown): error is { code?: string } {
  return (
    typeof error === "object" &&
    error !== null &&
    "code" in error &&
    (error as { code?: string }).code === "P2021"
  );
}

const listUsers = createServerFn({ method: "GET" }).handler(async () => {
  try {
    return await prisma.user.findMany({
      take: 10,
      orderBy: {
        createdAt: "desc",
      },
    });
  } catch (error) {
    if (isBootstrapQueryError(error)) {
      return undefined;
    }

    throw error;
  }
});

export const Route = createFileRoute("/")({
  loader: async () => listUsers(),
  component: Home,
});

function Home() {
  const formatter = new Intl.DateTimeFormat("en", {
    dateStyle: "medium",
    timeZone: "UTC",
  });
  const users = Route.useLoaderData();

  return (
    <main className="shell">
      <header className="intro">
        <div className="product">
          <span className="product-mark" aria-hidden="true">P</span>
          <span className="product-name">{{projectName}}</span>
          <span className="framework">TanStack Start</span>
        </div>
        <h1>Start building with Prisma.</h1>
        <p className="lede">
          Your app is connected and ready to query. The latest users from your database are shown
          below.
        </p>
      </header>

      <section className="user-panel" aria-labelledby="users-heading">
        <div className="panel-header">
          <div className="panel-title">
            <h2 id="users-heading">Users</h2>
            <p>Latest records</p>
          </div>
          <span className="count">{users?.length ?? 0}</span>
        </div>

        {!users ? (
          <p className="empty-state">
            The database is not ready yet. Check the setup steps in <code>README.md</code>.
          </p>
        ) : users.length === 0 ? (
          <p className="empty-state">No users yet. Run <code>db:seed</code>, then refresh.</p>
        ) : (
          <ul className="user-list">
            {users.map((user) => (
              <li className="user-row" key={user.id}>
                <span className="avatar" aria-hidden="true">
                  {(user.name ?? user.email).charAt(0).toUpperCase()}
                </span>
                <div className="user-copy">
                  <p className="user-name">{user.name ?? "Unnamed user"}</p>
                  <p className="user-email">{user.email}</p>
                </div>
                <time dateTime={user.createdAt.toISOString()}>
                  {formatter.format(user.createdAt)}
                </time>
              </li>
            ))}
          </ul>
        )}
      </section>

      <footer className="footer">
        <p>Start with <code>prisma/schema.prisma</code></p>
        <a className="docs-link" href="https://pris.ly/d/prisma-schema" target="_blank" rel="noreferrer">
          Prisma docs <span aria-hidden="true">↗</span>
        </a>
      </footer>
    </main>
  );
}
