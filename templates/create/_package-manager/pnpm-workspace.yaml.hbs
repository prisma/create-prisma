{{#if (eq packageManager "pnpm")}}
{{#if (eq template "turborepo")}}
packages:
  - "apps/*"
  - "packages/*"
{{/if}}
allowBuilds:
  esbuild: true
  msgpackr-extract: true
{{#if (eq template "next")}}
  sharp: true
  unrs-resolver: true
{{else if (eq template "astro")}}
  sharp: true
{{/if}}
  workerd: true
minimumReleaseAgeExclude:
  - "@prisma/*"
overrides:
  effect: "4.0.0-rc.115"
  "@effect/platform-bun": "4.0.0-rc.115"
  "@effect/platform-node": "4.0.0-rc.115"
  "@effect/platform-node-shared": "4.0.0-rc.115"
  "@effect/sql-d1": "4.0.0-rc.115"
  "@effect/sql-sqlite-do": "4.0.0-rc.115"
  "@effect/vitest": "4.0.0-rc.115"
{{#if (eq provider "mongo")}}
peerDependencyRules:
  allowedVersions:
    "alchemy>mongodb": "7"
{{/if}}
{{/if}}
