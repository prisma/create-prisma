{{#if (eq packageManager "pnpm")}}
{{#if (eq template "turborepo")}}
packages:
  - "apps/*"
  - "packages/*"
{{/if}}
autoInstallPeers: true
allowBuilds:
  esbuild: true
  msgpackr-extract: true
{{#if (eq template "next")}}
  sharp: true
  unrs-resolver: true
{{else if (eq template "astro")}}
  sharp: true
{{/if}}
  workerd: true
minimumReleaseAgeExclude:
  - "@prisma/*"
overrides:
  effect: "4.1.4"
  "@effect/platform-bun": "4.1.4"
  "@effect/platform-node": "4.1.4"
  "@effect/platform-node-shared": "4.1.4"
  "@effect/vitest": "4.1.4"
{{#if (eq provider "mongo")}}
peerDependencyRules:
  allowedVersions:
    "alchemy>mongodb": "7"
{{/if}}
{{/if}}
