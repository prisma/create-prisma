{
  "name": "{{projectName}}",
  "private": true,
  {{#if (packageManagerManifestValue packageManager)}}
  "packageManager": "{{packageManagerManifestValue packageManager}}",
  {{/if}}
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "{{runtimeScript packageManager "dev" "src/index.ts" "dist/src/index.js"}}",
    "build": "{{#if composer}}esbuild src/index.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire as __composerCreateRequire } from 'node:module'; const require = __composerCreateRequire(import.meta.url);\" --outfile=dist/server.mjs{{else}}{{runtimeScript packageManager "build" "src/index.ts" "dist/src/index.js"}}{{/if}}",
    "start": "{{#if composer}}node dist/server.mjs{{else}}{{runtimeScript packageManager "start" "src/index.ts" "dist/src/index.js"}}{{/if}}"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
