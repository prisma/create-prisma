{
  "name": "{{projectName}}",
  "private": true,
  {{#if (packageManagerManifestValue packageManager)}}
  "packageManager": "{{packageManagerManifestValue packageManager}}",
  {{/if}}
  "type": "module",
  "scripts": {
    "dev": "{{runtimeScript packageManager "dev" "src/index.ts" "dist/src/index.js"}}",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "^4.12.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "typescript": "^5.9.3"
  }
}
