{
  "name": "{{projectName}}",
  "private": true,
  {{#if packageManagerManifest}}
  "packageManager": "{{packageManagerManifest}}",
  {{/if}}
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "{{runtimeScript packageManager "dev" "src/index.ts" "dist/src/index.js"}}",
    "build": "tsdown",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3"
  }
}
