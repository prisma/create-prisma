{{#if (requiresDotenvConfigImport packageManager)}}
import "dotenv/config";
{{/if}}
import { node } from "@elysiajs/node";
import { Elysia } from "elysia";

import { prisma } from "./lib/prisma";

const rawPort = (process.env.PORT ?? "").trim();
const parsedPort = rawPort.length > 0 ? Number(rawPort) : Number.NaN;
const port =
  Number.isInteger(parsedPort) && parsedPort >= 0 && parsedPort <= 65535 ? parsedPort : 8080;

const runtimeAdapter = "Bun" in globalThis ? undefined : node();

const app = new Elysia({ adapter: runtimeAdapter })
  .get("/", () => {
    return {
      message: "hello from create-prisma + elysia",
    };
  })

  .get("/users", async () => {
    return prisma.user.findMany({
      take: 10,
      orderBy: {
        createdAt: "desc",
      },
    });
  })

  .listen(port);

console.log(`Server running at http://localhost:${app.server?.port ?? port}`);
