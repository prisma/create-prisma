{{#if (requiresDotenvConfigImport packageManager)}}
import "dotenv/config";
{{/if}}
import { node } from "@elysiajs/node";
import { Elysia } from "elysia";

import { listUsers } from "./prisma/users";

const rawPort = (process.env.PORT ?? "").trim();
const parsedPort = rawPort.length > 0 ? Number(rawPort) : Number.NaN;
const port =
  Number.isInteger(parsedPort) && parsedPort >= 0 && parsedPort <= 65535 ? parsedPort : 3000;

const app = new Elysia({ adapter: node() })
  .get("/", () => {
    return {
      message: "hello from create-prisma + elysia",
    };
  })

  .get("/users", async ({ set }) => {
    const users = await listUsers(10).catch((error) => {
      console.error("Failed to query users:", error);
      return undefined;
    });

    if (!users) {
      set.status = 500;
      return { error: "Could not query users yet. Run contract:emit and apply your schema first." };
    }

    return users;
  })

  .listen({ port, hostname: "0.0.0.0" });

console.log(`Server running at http://localhost:${app.server?.port ?? port}`);
