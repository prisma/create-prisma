{{#if (eq authoring "psl")}}
// use prisma-next
{{#if (eq schemaPreset "basic")}}
{{#if (eq provider "mongo")}}

model User {
  id    ObjectId @id @map("_id")
  email String   @unique
  name  String?
  posts Post[]

  @@map("users")
}

model Post {
  id       ObjectId @id @map("_id")
  title    String
  content  String?
  author   User     @relation(fields: [authorId], references: [id])
  authorId ObjectId

  @@map("posts")
}
{{else}}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  posts     Post[]
  createdAt DateTime @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime @default(now())
}
{{/if}}
{{/if}}
{{/if}}
