<script setup lang="ts">
useHead({
  title: "{{projectName}} · Prisma",
  meta: [
    {
      name: "description",
      content: "A minimal Prisma starter generated by create-prisma.",
    },
  ],
});

type User = {
  id: string;
  email: string;
  name: string | null;
  createdAt: string;
};

type UsersPayload = {
  users: User[];
  error?: string;
};

const formatter = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
});

const { data } = await useFetch<UsersPayload>("/api/users");

function formatCreatedAt(value: string): string {
  return formatter.format(new Date(value));
}

function getInitial(user: User): string {
  return (user.name ?? user.email).charAt(0).toUpperCase();
}
</script>

<template>
  <main class="shell">
    <header class="intro">
      <div class="product">
        <span class="product-mark" aria-hidden="true">P</span>
        <span class="product-name">{{projectName}}</span>
        <span class="framework">Nuxt</span>
      </div>
      <h1>Start building with Prisma.</h1>
      <p class="lede">
        Your app is connected and ready to query. The latest users from your database are shown
        below.
      </p>
    </header>

    <section class="user-panel" aria-labelledby="users-heading">
      <div class="panel-header">
        <div class="panel-title">
          <h2 id="users-heading">Users</h2>
          <p>Latest records</p>
        </div>
        <span class="count">\{{ data?.users?.length ?? 0 }}</span>
      </div>

      <p v-if="data?.error" class="empty-state">
        The database is not ready yet. Check the setup steps in <code>README.md</code>.
      </p>
      <p v-else-if="!data?.users?.length" class="empty-state">
        No users yet. Run <code>db:seed</code>, then refresh.
      </p>
      <ul v-else class="user-list">
        <li v-for="user in data.users" :key="user.id" class="user-row">
          <span class="avatar" aria-hidden="true">\{{ getInitial(user) }}</span>
          <div class="user-copy">
            <p class="user-name">\{{ user.name ?? "Unnamed user" }}</p>
            <p class="user-email">\{{ user.email }}</p>
          </div>
          <time :datetime="user.createdAt">\{{ formatCreatedAt(user.createdAt) }}</time>
        </li>
      </ul>
    </section>

    <footer class="footer">
      <p>Start with <code>prisma/schema.prisma</code></p>
      <a class="docs-link" href="https://pris.ly/d/prisma-schema" target="_blank" rel="noreferrer">
        Prisma docs <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </main>
</template>
