{
  "name": "{{projectName}}",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "private": true,
  "version": "0.0.1",
  {{#if (packageManagerManifestValue packageManager)}}
  "packageManager": "{{packageManagerManifestValue packageManager}}",
  {{/if}}
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare{{#if skillAgents.length}} && {{runScriptCommand packageManager "skills:sync"}}{{/if}}",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "nuxt": "^4.6.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12"
  }
}
