{
  "name": "{{projectName}}",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  {{#if (packageManagerManifestValue packageManager)}}
  "packageManager": "{{packageManagerManifestValue packageManager}}",
  {{/if}}
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && {{runScriptCommand packageManager "skills:sync"}}",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "nuxt": "^4.3.1",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.2",
    "vue-tsc": "^3.3.9"
  }
}
