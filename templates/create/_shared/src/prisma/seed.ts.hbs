import "dotenv/config";
{{#if (eq provider "postgres")}}
import { readFile } from "node:fs/promises";

async function loadComposerDevDatabaseUrl(): Promise<string | undefined> {
  try {
    const contents = await readFile(
      new URL("../../.prisma-composer/dev/env.json", import.meta.url),
      "utf8",
    );
    const env = JSON.parse(contents) as Record<string, unknown>;
    const value = env.COMPOSER_APP_DATABASE_URL;
    return typeof value === "string" && value.length > 0 ? value : undefined;
  } catch {
    return undefined;
  }
}

process.env.DATABASE_URL ??= await loadComposerDevDatabaseUrl();
{{/if}}

if (!process.env.DATABASE_URL) {
  throw new Error(
    "DATABASE_URL is not set. Run dev:composer once to create the local database, or set DATABASE_URL explicitly.",
  );
}

const [{ db }, { seedStarterData }] = await Promise.all([
  import("./db.ts"),
  import("./starter-data.ts"),
]);

try {
  await seedStarterData();
  console.log("Starter users are ready.");
} finally {
  await db.close();
}
