{{#if (requiresDotenvConfigImport packageManager)}}
import "dotenv/config";
{{/if}}
import { db } from "./db{{#if (eq packageManager "deno")}}.ts{{/if}}";

const seedUsers = [
  { email: "alice@prisma.io", username: "alice", name: "Alice" },
  { email: "bob@prisma.io", username: "bob", name: "Bob" },
  { email: "carol@prisma.io", username: "carol", name: "Carol" },
];

let createdCount = 0;

{{#if (eq provider "mongo")}}
try {
  for (const user of seedUsers) {
    const existingUser = await db.orm.users.where({ email: user.email }).first();
    if (!existingUser) {
      await db.orm.users.create(user);
      createdCount += 1;
    }
  }

  console.log(`Seeded ${createdCount} user${createdCount === 1 ? "" : "s"}.`);
} finally {
  await db.close();
}
{{else}}
try {
  for (const user of seedUsers) {
    const existingUser = await db.orm.public.User.where({ email: user.email }).first();
    if (!existingUser) {
      await db.orm.public.User.create(user);
      createdCount += 1;
    }
  }

  console.log(`Seeded ${createdCount} user${createdCount === 1 ? "" : "s"}.`);
} finally {
  await db.close();
}
{{/if}}
