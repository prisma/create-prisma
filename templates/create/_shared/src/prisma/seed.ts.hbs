import "dotenv/config";

if (!process.env.DATABASE_URL) {
  throw new Error(
    "DATABASE_URL is not set. Set it explicitly for this standalone command. Composer apps seed through their service binding on the first database query.",
  );
}

const [{ db }, { seedStarterData }] = await Promise.all([
  import("./db.ts"),
  import("./starter-data.ts"),
]);

try {
  await seedStarterData();
  console.log("Starter users are ready.");
} finally {
  await db.close();
}
