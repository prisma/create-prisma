import { db } from "./db.ts";
import { seed } from "./seed.ts";

export { db };

export async function listUsers(limit = 10) {
  await seed();
{{#if (eq provider "mongo")}}
  const users = [];

  for await (const user of db.orm.users.select("_id", "email", "username", "name").limit(limit).all()) {
    users.push({
      id: String(user._id),
      email: user.email,
      username: user.username ?? null,
      name: user.name ?? null,
      createdAt: null as string | null,
    });
  }

  return users;
{{else}}
  const users = await db.orm.public.User.select("id", "email", "username", "name", "createdAt").limit(limit).all();

  return users.map((user) => ({
    id: String(user.id),
    email: user.email,
    username: user.username ?? null,
    name: user.name ?? null,
    createdAt: user.createdAt,
  }));
{{/if}}
}

export type StarterUser = Awaited<ReturnType<typeof listUsers>>[number];
