{{#unless (eq packageManager "deno")}}
{{#if tsdownEntry}}
import { isBuiltin } from "node:module";
import { defineConfig } from "tsdown";

{{#if (eq template "nest")}}
const optionalNestDependencies = [
  /^@nestjs\/microservices(?:\/|$)/,
  /^@nestjs\/platform-socket\.io(?:\/|$)/,
  /^@nestjs\/websockets(?:\/|$)/,
  /^class-transformer(?:\/|$)/,
  /^class-validator(?:\/|$)/,
];

{{/if}}
export default defineConfig({
  entry: { server: "{{tsdownEntry}}" },
  platform: "node",
  target: "node22.18",
  format: "esm",
  clean: true,
  hash: false,
  outputOptions: {
    codeSplitting: false,
  },
  deps: {
    onlyBundle: false,
    alwaysBundle: (id) =>
      !isBuiltin(id){{#if (eq template "nest")}} &&
      !optionalNestDependencies.some((pattern) => pattern.test(id)){{/if}},
{{#if (eq template "nest")}}
    neverBundle: optionalNestDependencies,
{{/if}}
  },
});
{{/if}}
{{/unless}}
