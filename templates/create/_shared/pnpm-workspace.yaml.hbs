{{#if (eq packageManager "pnpm")}}
{{#if (eq template "turborepo")}}
packages:
  - "apps/*"
  - "packages/*"
{{/if}}
allowBuilds:
  esbuild: true
  msgpackr-extract: true
{{#if (or (eq template "next") (eq template "turborepo"))}}
  sharp: true
  unrs-resolver: true
{{else if (eq template "astro")}}
  sharp: true
{{/if}}
  workerd: true
minimumReleaseAgeExclude:
  - "@prisma/*"
overrides:
  effect: "4.0.0-rc.112"
{{/if}}
