---
import prisma from "../lib/prisma";
import "../styles.css";

const formatter = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
});

const users = await prisma.user
  .findMany({
    take: 10,
    orderBy: {
      createdAt: "desc",
    },
  })
  .catch(() => undefined);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="A minimal Prisma starter generated by create-prisma." />
    <title>{{projectName}} · Prisma</title>
  </head>
  <body>
    <main class="shell">
      <header class="intro">
        <div class="product">
          <span class="product-mark" aria-hidden="true">P</span>
          <span class="product-name">{{projectName}}</span>
          <span class="framework">Astro</span>
        </div>
        <h1>Start building with Prisma.</h1>
        <p class="lede">
          Your app is connected and ready to query. The latest users from your database are shown
          below.
        </p>
      </header>

      <section class="user-panel" aria-labelledby="users-heading">
        <div class="panel-header">
          <div class="panel-title">
            <h2 id="users-heading">Users</h2>
            <p>Latest records</p>
          </div>
          <span class="count">{users?.length ?? 0}</span>
        </div>

        {!users ? (
          <p class="empty-state">
            The database is not ready yet. Check the setup steps in <code>README.md</code>.
          </p>
        ) : users.length === 0 ? (
          <p class="empty-state">No users yet. Run <code>db:seed</code>, then refresh.</p>
        ) : (
          <ul class="user-list">
            {users.map((user) => (
              <li class="user-row">
                <span class="avatar" aria-hidden="true">
                  {(user.name ?? user.email).charAt(0).toUpperCase()}
                </span>
                <div class="user-copy">
                  <p class="user-name">{user.name ?? "Unnamed user"}</p>
                  <p class="user-email">{user.email}</p>
                </div>
                <time datetime={user.createdAt.toISOString()}>
                  {formatter.format(user.createdAt)}
                </time>
              </li>
            ))}
          </ul>
        )}
      </section>

      <footer class="footer">
        <p>Start with <code>prisma/schema.prisma</code></p>
        <a class="docs-link" href="https://pris.ly/d/prisma-schema" target="_blank" rel="noreferrer">
          Prisma docs <span aria-hidden="true">↗</span>
        </a>
      </footer>
    </main>
  </body>
</html>
