---
{{#if (eq schemaPreset "basic")}}
import { listUsers } from "../lib/prisma";

const formatter = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
  timeStyle: "short",
});

const users = await listUsers(10).catch(() => undefined);
{{/if}}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>create-prisma + astro</title>
  </head>
  <body>
    <main class="shell">
      <div class="hero">
        <p class="eyebrow">Astro + Prisma Next</p>
{{#if (eq schemaPreset "basic")}}
        <h1>Users from your database, loaded on the server.</h1>
        <p class="lede">
          This page reads from <code>src/pages/index.astro</code> using the Prisma Next helper in
          <code>src/lib/prisma.ts</code>. An Astro API route is also scaffolded in
          <code>src/pages/api/users.ts</code>.
        </p>
      </div>

      <section class="panel">
        <div class="panel-header">
          <h2>Seeded users</h2>
          <span>{users?.length ?? 0} total</span>
        </div>

        {!users ? (
          <p class="empty">
            Could not query users yet. Run <code>contract:emit</code> and <code>db:init</code>,
            then refresh after applying your schema.
          </p>
        ) : users.length === 0 ? (
          <p class="empty">No users yet. Add rows after applying your first migration.</p>
        ) : (
          <ul class="users">
            {users.map((user) => (
              <li>
                <div>
                  <strong>{user.name ?? "Unnamed user"}</strong>
                  <p>{user.email}</p>
                </div>
                {user.createdAt ? (
                  <time datetime={user.createdAt.toISOString()}>
                    {formatter.format(user.createdAt)}
                  </time>
                ) : (
                  <span class="muted">No timestamp</span>
                )}
              </li>
            ))}
          </ul>
        )}
      </section>
{{else}}
        <h1>Your Astro app is ready.</h1>
        <p class="lede">
          Edit your Prisma Next contract, run <code>contract:emit</code>, then load your data
          in Astro pages or API routes with the helper in <code>src/lib/prisma.ts</code>.
        </p>
      </div>

      <section class="panel">
        <div class="panel-header">
          <h2>What's included</h2>
          <span>Starter kit</span>
        </div>

        <ul class="users">
          <li>
            <div>
              <strong>Prisma client</strong>
              <p>Use the shared Prisma Next runtime from <code>src/lib/prisma.ts</code>.</p>
            </div>
          </li>
          <li>
            <div>
              <strong>API route example</strong>
              <p>See <code>src/pages/api/users.ts</code> for an Astro server endpoint.</p>
            </div>
          </li>
          <li>
            <div>
              <strong>Manual database setup</strong>
              <p>Run <code>db:init</code> and migrations when you are ready.</p>
            </div>
          </li>
        </ul>
      </section>
{{/if}}
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    background: #fff;
    color: #111;
  }

  .shell {
    max-width: 40rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .hero {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: #666;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .lede {
    margin: 0.5rem 0 0;
    color: #666;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .panel {
    border: 1px solid #e5e5e5;
    border-radius: 0.5rem;
    padding: 1rem;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  h2 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .panel-header span,
  .empty,
  .muted,
  time {
    color: #888;
    font-size: 0.8rem;
  }

  .panel p {
    color: #666;
    font-size: 0.8rem;
  }

  .users {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .users li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid #eee;
    border-radius: 0.375rem;
  }

  .users p {
    margin: 0.125rem 0 0;
  }

  time {
    font-size: 0.75rem;
    white-space: nowrap;
  }

  code {
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    background: #f5f5f5;
    font-family: SFMono-Regular, Consolas, monospace;
    font-size: 0.875em;
  }

  @media (max-width: 640px) {
    .users li,
    .panel-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
