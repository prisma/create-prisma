{
  "name": "{{projectName}}",
  "private": true,
  {{#if (packageManagerManifestValue packageManager)}}
  "packageManager": "{{packageManagerManifestValue packageManager}}",
  {{/if}}
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "{{runtimeScript packageManager "dev" "src/main.ts" "dist/main.js"}}",
    "build": "tsdown",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3"
  }
}
