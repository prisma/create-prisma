{
  "name": "{{projectName}}",
  "private": true,
  {{#if (packageManagerManifestValue packageManager)}}
  "packageManager": "{{packageManagerManifestValue packageManager}}",
  {{/if}}
  "type": "module",
  "scripts": {
    "dev": "{{runtimeScript packageManager "dev" "src/main.ts" "dist/main.js"}}",
    "build": "tsc && esbuild dist/main.js --bundle --platform=node --format=esm --banner:js=\"import { createRequire as __composerCreateRequire } from 'node:module'; const require = __composerCreateRequire(import.meta.url);\" --external:@nestjs/microservices --external:'@nestjs/microservices/*' --external:'@nestjs/websockets/*' --external:class-transformer --external:class-validator --outfile=dist-composer/server.mjs",
    "start": "node dist-composer/server.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
